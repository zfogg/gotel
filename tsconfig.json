{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "typescript",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["typescript/**/*.ts"],
  "exclude": ["typescript/**/*.test.ts"]
}
