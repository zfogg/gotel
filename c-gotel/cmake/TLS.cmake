# Stage the pinned upstream sources: its internal URL structure needs a TLS bit
# in every translation unit. Never modify the shared FetchContent source cache.
set(_stage "${CMAKE_CURRENT_BINARY_DIR}/otlp-tls")
file(MAKE_DIRECTORY "${_stage}")
file(READ "${otlp_c_SOURCE_DIR}/src/http_client.c" _http_source)
string(SHA256 _http_hash "${_http_source}")
file(READ "${otlp_c_SOURCE_DIR}/src/http_client.h" _http_header)
string(SHA256 _header_hash "${_http_header}")
if(NOT _http_hash STREQUAL "f5a511b4b624266ce4dbafc85b6ce94aae715dd1bb199cc7c64c664d8634c393" OR
   NOT _header_hash STREQUAL "9ec75f239f20b0d669dc7207ddcfa08bbd90a1ea338a5562709acd7859a52e3f")
  message(FATAL_ERROR "The pinned otlp-c HTTP implementation changed; review the TLS adapter")
endif()

file(GLOB _headers "${otlp_c_SOURCE_DIR}/src/*.h")
foreach(_header IN LISTS _headers)
  configure_file("${_header}" "${_stage}/" COPYONLY)
endforeach()
file(READ "${_stage}/http_client.h" _header)
string(REPLACE "uint16_t port;" "uint16_t port;\n int tls;" _header "${_header}")
file(WRITE "${_stage}/http_client.h" "${_header}")
get_target_property(_sources otlp_c SOURCES)
set(_patched_sources)
foreach(_source IN LISTS _sources)
  if(IS_ABSOLUTE "${_source}")
    set(_path "${_source}")
  else()
    set(_path "${otlp_c_SOURCE_DIR}/${_source}")
  endif()
  get_filename_component(_name "${_path}" NAME)
  file(READ "${_path}" _code)
  if(_name STREQUAL "http_client.c")
    string(REPLACE "#include \"http_client.h\"" "#include \"http_client.h\"\n#include \"tls.h\"" _code "${_code}")
    string(FIND "${_code}" "static int\nparse_uint16" _parser_start)
    string(FIND "${_code}" "struct otlp_http_request\n" _parser_end)
    string(SUBSTRING "${_code}" 0 ${_parser_start} _before)
    string(SUBSTRING "${_code}" ${_parser_end} -1 _after)
    file(READ "${CMAKE_CURRENT_SOURCE_DIR}/src/url.inc" _parser)
    set(_code "${_before}${_parser}\n${_after}")
    string(REPLACE "\"Host: %s\\r\\n\"" "\"Host: %s%s%s:%u\\r\\n\"" _code "${_code}")
    string(REPLACE "url->host,\n\t\t\tua);" "strchr(url->host, ':') ? \"[\" : \"\", url->host, strchr(url->host, ':') ? \"]\" : \"\", (unsigned)url->port,\n\t\t\tua);" _code "${_code}")
    string(REPLACE "otlp_http_req_state_t state;" "otlp_http_req_state_t state;\n gotel_tls *tls;" _code "${_code}")
    string(REPLACE "r->state = OTLP_HTTP_REQ_CONNECTING;" "r->state = OTLP_HTTP_REQ_CONNECTING;\n if (url->tls && !(r->tls = gotel_tls_create(url->host))) { otlp_free(r); return OTLP_ERR_INVALID_ARGUMENT; }" _code "${_code}")
    string(REPLACE "otlp_free(r->req_buf);" "gotel_tls_free(r->tls);\n otlp_free(r->req_buf);" _code "${_code}")
    string(REPLACE "!r->keepalive_eligible)" "!r->keepalive_eligible || r->tls)" _code "${_code}")
    string(REPLACE "st = otlp_socket_write(r->sock," "st = r->tls ? gotel_tls_write(r->tls, r->sock, r->req_buf + r->req_sent, r->req_len - r->req_sent, &n_written) : otlp_socket_write(r->sock," _code "${_code}")
    string(REPLACE "st = otlp_socket_read(r->sock, small, sizeof(small), &n_read);" "st = r->tls ? gotel_tls_read(r->tls, r->sock, small, sizeof(small), &n_read) : otlp_socket_read(r->sock, small, sizeof(small), &n_read);" _code "${_code}")
    string(REPLACE "if (otlp_socket_eof(r->sock))" "if (r->tls ? gotel_tls_eof(r->tls) : otlp_socket_eof(r->sock))" _code "${_code}")
    string(REPLACE "if (!r)\n\t\treturn 0;\n\tswitch" "if (!r)\n\t\treturn 0;\n if (r->tls && r->state != OTLP_HTTP_REQ_CONNECTING && r->state != OTLP_HTTP_REQ_DONE && r->state != OTLP_HTTP_REQ_FAILED) return gotel_tls_events(r->tls);\n\tswitch" _code "${_code}")
  endif()
  file(WRITE "${_stage}/${_name}" "${_code}")
  list(APPEND _patched_sources "${_stage}/${_name}")
endforeach()
set_property(TARGET otlp_c PROPERTY SOURCES "${_patched_sources}")
if(NOT TARGET OpenSSL::SSL OR NOT TARGET OpenSSL::Crypto)
  find_package(OpenSSL 1.1.1 REQUIRED COMPONENTS SSL Crypto)
endif()
target_sources(otlp_c PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/tls.c")
target_include_directories(otlp_c PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src")
target_link_libraries(otlp_c PRIVATE OpenSSL::SSL OpenSSL::Crypto)
if(WIN32)
  target_link_libraries(otlp_c PRIVATE crypt32)
elseif(APPLE)
  target_link_libraries(otlp_c PRIVATE "-framework Security" "-framework CoreFoundation")
endif()
