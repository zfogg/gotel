# Consumers may provide their existing dependency targets. Do not rediscover or
# build a second copy when c-gotel is embedded in an application.
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
set(CGOTEL_UTF8PROC_TARGET "" CACHE STRING "Existing utf8proc CMake target")
set(CGOTEL_PCRE2_TARGET "" CACHE STRING "Existing 8-bit PCRE2 CMake target")
if(NOT CGOTEL_UTF8PROC_TARGET)
  find_package(utf8proc CONFIG QUIET)
  if(TARGET utf8proc::utf8proc)
    set(CGOTEL_UTF8PROC_TARGET utf8proc::utf8proc)
  elseif(TARGET utf8proc)
    set(CGOTEL_UTF8PROC_TARGET utf8proc)
  else()
    set(UTF8PROC_ENABLE_TESTING OFF)
    set(UTF8PROC_INSTALL OFF)
    FetchContent_Declare(cgotel_utf8proc
      GIT_REPOSITORY https://github.com/JuliaStrings/utf8proc.git
      GIT_TAG e5e799221b45bbb90f5fdc5c69b6b8dfbf017e78)
    FetchContent_MakeAvailable(cgotel_utf8proc)
    set(CGOTEL_UTF8PROC_TARGET utf8proc)
  endif()
endif()
if(NOT CGOTEL_PCRE2_TARGET)
  find_package(PCRE2 CONFIG QUIET COMPONENTS 8BIT)
  if(TARGET PCRE2::8BIT)
    set(CGOTEL_PCRE2_TARGET PCRE2::8BIT)
  else()
    set(PCRE2_BUILD_PCRE2_8 ON)
    set(PCRE2_BUILD_PCRE2_16 OFF)
    set(PCRE2_BUILD_PCRE2_32 OFF)
    set(PCRE2_BUILD_PCRE2GREP OFF)
    set(PCRE2_BUILD_TESTS OFF)
    set(PCRE2_STATIC_PIC ON)
    set(BUILD_STATIC_LIBS ON)
    if(BUILD_SHARED_LIBS)
      set(BUILD_STATIC_LIBS OFF)
    endif()
    FetchContent_Declare(cgotel_pcre2
      URL https://github.com/PCRE2Project/pcre2/archive/refs/tags/pcre2-10.47.tar.gz
      URL_HASH SHA256=409c443549b13b216da40049850a32f3e6c57d4224ab11553ab5a786878a158e
      DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(cgotel_pcre2)
    if(BUILD_SHARED_LIBS)
      set(CGOTEL_PCRE2_TARGET pcre2-8-shared)
    else()
      set(CGOTEL_PCRE2_TARGET pcre2-8-static)
    endif()
  endif()
endif()
foreach(_dependency IN ITEMS CGOTEL_UTF8PROC_TARGET CGOTEL_PCRE2_TARGET)
  if(NOT TARGET "${${_dependency}}")
    message(FATAL_ERROR "${_dependency} must name an existing CMake target")
  endif()
endforeach()
