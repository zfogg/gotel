# Consumers may provide their existing dependency targets. Do not rediscover or
# build a second copy when gotel is embedded in an application.
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
set(GOTEL_UTF8PROC_TARGET "" CACHE STRING "Existing utf8proc CMake target")
set(GOTEL_PCRE2_TARGET "" CACHE STRING "Existing 8-bit PCRE2 CMake target")
if(NOT GOTEL_UTF8PROC_TARGET)
  if(TARGET utf8proc::utf8proc)
    set(GOTEL_UTF8PROC_TARGET utf8proc::utf8proc)
  elseif(TARGET utf8proc)
    set(GOTEL_UTF8PROC_TARGET utf8proc)
  else()
    find_package(utf8proc CONFIG QUIET)
    if(TARGET utf8proc::utf8proc)
      set(GOTEL_UTF8PROC_TARGET utf8proc::utf8proc)
    elseif(TARGET utf8proc)
      set(GOTEL_UTF8PROC_TARGET utf8proc)
    endif()
  endif()
endif()
if(NOT GOTEL_PCRE2_TARGET)
  find_package(PCRE2 CONFIG QUIET COMPONENTS 8BIT)
  if(TARGET PCRE2::8BIT)
    set(GOTEL_PCRE2_TARGET PCRE2::8BIT)
  else()
    set(PCRE2_BUILD_PCRE2_8 ON)
    set(PCRE2_BUILD_PCRE2_16 OFF)
    set(PCRE2_BUILD_PCRE2_32 OFF)
    set(PCRE2_BUILD_PCRE2GREP OFF)
    set(PCRE2_BUILD_TESTS OFF)
    set(PCRE2_STATIC_PIC ON)
    set(BUILD_STATIC_LIBS ON)
    FetchContent_Declare(gotel_pcre2
      URL https://github.com/PCRE2Project/pcre2/archive/refs/tags/pcre2-10.47.tar.gz
      URL_HASH SHA256=409c443549b13b216da40049850a32f3e6c57d4224ab11553ab5a786878a158e
      DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(gotel_pcre2)
    set(GOTEL_PCRE2_TARGET pcre2-8-static)
  endif()
endif()
foreach(_dependency IN ITEMS GOTEL_UTF8PROC_TARGET GOTEL_PCRE2_TARGET)
  if(NOT TARGET "${${_dependency}}")
    message(FATAL_ERROR "${_dependency} must name an existing CMake target")
  endif()
endforeach()
