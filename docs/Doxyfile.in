PROJECT_NAME = "Gotel C API"
PROJECT_BRIEF = "OpenTelemetry conventions and native instrumentation"
OUTPUT_DIRECTORY = "@DOCS_OUTPUT_DIR@/c"
INPUT = "@_docs_root@/c/include/gotel" "@_docs_root@/docs/c.md"
USE_MDFILE_AS_MAINPAGE = "@_docs_root@/docs/c.md"
HTML_OUTPUT = .
GENERATE_HTML = YES
GENERATE_LATEX = NO
OPTIMIZE_OUTPUT_FOR_C = YES
EXTRACT_ALL = YES
WARN_IF_UNDOCUMENTED = YES
WARN_NO_PARAMDOC = NO
WARN_AS_ERROR = YES
QUIET = YES
HAVE_DOT = NO
FULL_PATH_NAMES = NO
JAVADOC_AUTOBRIEF = YES
HTML_COLORSTYLE = AUTO_LIGHT
SOURCE_BROWSER = YES
INLINE_SOURCES = NO
GENERATE_TREEVIEW = YES
PREDEFINED = GOTEL_WITH_SQLITE=1 GOTEL_LOG_SOURCE_ENABLED=1
MACRO_EXPANSION = NO
