# syntax=docker/dockerfile:1.7
FROM node:22-bookworm AS build
RUN npm install --global pnpm@10.20.0
WORKDIR /src
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build
RUN pnpm --dir examples/full-stack/browser install --frozen-lockfile \
    && pnpm --dir examples/full-stack/browser build

FROM nginx:1.27-alpine
COPY --from=build /src/examples/full-stack/browser/dist /usr/share/nginx/html
COPY examples/full-stack/browser/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
